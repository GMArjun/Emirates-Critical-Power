---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import { heroImageUrl } from '../lib/heroImage';
import About from '../components/About.astro';
import Services from '../components/Services.astro';
import Batteries from '../components/Batteries.astro';
import Industries from '../components/Industries.astro';
import Brands from '../components/Brands.astro';
import WhyUs from '../components/WhyUs.astro';
import Gallery from '../components/Gallery.astro';
import Reseller from '../components/Reseller.astro';
import FAQ from '../components/FAQ.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
import WhatsAppFloat from '../components/WhatsAppFloat.astro';
---

<BaseLayout preloadImage={heroImageUrl}>
  <Header />
  <main>
    <Hero />
    <About />
    <Services />
    <Batteries />
    <Industries />
    <Brands />
    <WhyUs />
    <Gallery />
    <Reseller />
    <FAQ />
    <Contact />
  </main>
  <Footer />
  <WhatsAppFloat />
</BaseLayout>
