---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppFloat from '../components/WhatsAppFloat.astro';
import { site } from '../data/site';

const btn =
  'inline-flex items-center justify-center rounded-md px-[22px] py-[11px] text-sm font-semibold whitespace-nowrap transition-all duration-200';
---

<BaseLayout
  title={`Page Not Found | ${site.shortName}`}
  description="The page you're looking for doesn't exist. Head back to the homepage or get in touch for UPS installation, maintenance and battery support."
  noindex
>
  <Header />

  <section class="bg-navy-deep py-28 text-white">
    <div class="mx-auto max-w-[640px] px-6 text-center">
      <div class="mb-3.5 flex items-center justify-center gap-2.5 font-mono text-xs tracking-[0.14em] text-orange uppercase before:inline-block before:h-0.5 before:w-[22px] before:bg-orange">
        404
      </div>
      <h1 class="text-[clamp(32px,4vw,48px)]">This page went offline</h1>
      <p class="mt-4 text-[16px] text-white/75">
        The page you're looking for doesn't exist or has moved. Let's get you back on track.
      </p>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <a href="/" class={`${btn} btn-orange`}>Back to homepage</a>
        <a href={site.whatsapp} class={`${btn} btn-white`}>WhatsApp us</a>
      </div>
    </div>
  </section>

  <Footer />
  <WhatsAppFloat />
</BaseLayout>
