---
import { site } from '../data/site';

const btn =
  'inline-flex w-full items-center justify-center gap-2 rounded-lg px-[30px] py-[15px] text-[15px] font-semibold whitespace-nowrap transition-all duration-200 sm:w-auto';
const btnOrange = `${btn} btn-orange`;
const btnWhite = `${btn} btn-white`;

const details = [
  { label: 'Call', value: site.phoneDisplay, href: `tel:${site.phone}` },
  { label: 'Email', value: site.email, href: `mailto:${site.email}` },
  { label: 'Location', value: site.address },
  { label: 'Support', value: '24 / 7' },
];
---

<section class="bg-grey py-[88px]" id="contact">
  <div class="mx-auto max-w-[800px] px-6" data-reveal>
    <div class="relative overflow-hidden rounded-2xl bg-linear-to-br from-navy to-navy-deep p-10 text-center text-white after:absolute after:right-[-40px] after:bottom-[-40px] after:h-[180px] after:w-[180px] after:rounded-full after:bg-[radial-gradient(circle,rgba(255,107,0,0.25),transparent_70%)] after:content-[''] md:p-14">
      <div class="relative mb-3.5 flex items-center justify-center gap-2.5 font-mono text-xs tracking-[0.14em] text-orange uppercase before:inline-block before:h-0.5 before:w-[22px] before:bg-orange">
        Get in touch
      </div>
      <h2 class="relative mb-8 text-[28px]">Talk to a UPS engineer today</h2>

      <div class="relative mx-auto mb-8 max-w-[480px] text-left">
        {
          details.map((item, i) => (
            <div class={`flex justify-between gap-4 py-3 font-mono text-[13.5px] ${i === details.length - 1 ? '' : 'border-b border-white/14'}`}>
              <span class="text-white/60">{item.label}</span>
              {item.href ? (
                <a href={item.href} class="font-medium text-orange hover:underline">
                  {item.value}
                </a>
              ) : (
                <span class="font-medium text-orange">{item.value}</span>
              )}
            </div>
          ))
        }
      </div>

      <div class="relative flex flex-wrap justify-center gap-3">
        <a href={site.whatsapp} class={btnOrange}>WhatsApp Us Now</a>
        <a href={`tel:${site.phone}`} class={btnWhite}>Call Now</a>
      </div>
    </div>
  </div>
</section>
