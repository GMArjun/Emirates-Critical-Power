---
import { site } from '../data/site';

export const heroImageUrl = 'https://images.unsplash.com/photo-1742491387035-f658e8a2b7f4?fm=jpg&q=80&w=1800&auto=format&fit=crop';

const btn =
  'inline-flex items-center justify-center gap-2 rounded-lg px-[30px] py-[15px] text-[15px] font-semibold whitespace-nowrap transition-all duration-200';
const btnOrange = `${btn} btn-orange`;
const btnWhite = `${btn} btn-white`;
---

<section
  id="top"
  class="relative overflow-hidden bg-navy-deep bg-cover bg-[center_35%] bg-no-repeat pt-[100px] text-white"
  style={`background-image: linear-gradient(180deg, rgba(0,20,40,0.82) 0%, rgba(0,42,84,0.90) 55%, #003366 100%), url('${heroImageUrl}');`}
>
  <div
    class="pointer-events-none absolute inset-0"
    style="background-image: linear-gradient(rgba(255,255,255,0.045) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.045) 1px, transparent 1px); background-size: 44px 44px; mask-image: radial-gradient(ellipse 80% 60% at 50% 20%, black 30%, transparent 80%);"
  >
  </div>
  <div class="relative z-2 mx-auto max-w-[1200px] px-6 text-center">
    <div class="mb-3.5 flex items-center justify-center gap-2.5 font-mono text-xs tracking-[0.14em] text-orange uppercase before:inline-block before:h-0.5 before:w-[22px] before:bg-orange">
      UPS Installation Dubai — Critical Power Engineering, UAE-Wide
    </div>
    <h1 class="mx-auto mb-[22px] max-w-[920px] text-[clamp(34px,5.2vw,64px)] leading-[1.06]">
      UAE's Trusted <span class="text-orange">UPS Installation</span> &amp; Critical Power Specialists
    </h1>
    <p class="mx-auto mb-[34px] max-w-[640px] font-mono text-[17px] tracking-[0.01em] text-white/78">
      SUPPLY · INSTALLATION · COMMISSIONING · AMC · BATTERY REPLACEMENT · 24/7 EMERGENCY SUPPORT
    </p>
    <div class="mb-14 flex flex-wrap justify-center gap-3.5">
      <a href="#contact" class={btnOrange}>Get Free Quote</a>
      <a href={site.whatsapp} class={btnWhite}>WhatsApp Now</a>
    </div>

    <div class="relative mx-auto h-[150px] max-w-[900px]">
      <span class="absolute top-1.5 left-0 font-mono text-[11px] tracking-[0.08em] text-white/40 uppercase">Mains failure</span>
      <span class="absolute top-1.5 right-0 font-mono text-[11px] tracking-[0.08em] text-[#3fd39a] uppercase">Zero downtime</span>
      <svg class="h-full w-full" viewBox="0 0 900 150" preserveAspectRatio="none" aria-hidden="true">
        <path
          class="hero-wave-path fill-none stroke-orange stroke-[2.5] [stroke-linecap:round] drop-shadow-[0_0_6px_rgba(255,107,0,0.5)]"
          pathLength="1"
          d="M0,75 C20,20 40,130 60,75 C80,20 100,130 120,75 C140,20 160,130 180,75 C200,20 220,130 240,75 C260,20 280,130 300,75 C320,45 340,75 360,75 C420,75 460,75 900,75"
        >
        </path>
        <path class="fill-none stroke-[#3fd39a] stroke-[2.5] [stroke-linecap:round] drop-shadow-[0_0_6px_rgba(63,211,154,0.5)]" d="M360,75 L900,75" stroke-dasharray="4 4">
          <animate attributeName="stroke-dashoffset" from="200" to="0" dur="2.4s" repeatCount="indefinite"></animate>
        </path>
        <circle cx="360" cy="75" r="5" fill="#FF6B00"></circle>
      </svg>
    </div>

    <div class="flex flex-wrap justify-center border-t border-white/12 py-7">
      <div class="border-r border-white/12 px-10 text-center last:border-r-0 max-[560px]:px-[18px]">
        <b class="block font-display text-[28px] text-white">1–600</b>
        <span class="font-mono text-xs tracking-[0.05em] text-white/55">kVA range</span>
      </div>
      <div class="border-r border-white/12 px-10 text-center last:border-r-0 max-[560px]:px-[18px]">
        <b class="block font-display text-[28px] text-white">24/7</b>
        <span class="font-mono text-xs tracking-[0.05em] text-white/55">emergency support</span>
      </div>
      <div class="border-r border-white/12 px-10 text-center last:border-r-0 max-[560px]:px-[18px]">
        <b class="block font-display text-[28px] text-white">15+</b>
        <span class="font-mono text-xs tracking-[0.05em] text-white/55">UPS brands serviced</span>
      </div>
      <div class="border-r border-white/12 px-10 text-center last:border-r-0 max-[560px]:px-[18px]">
        <b class="block font-display text-[28px] text-white">&lt;60min</b>
        <span class="font-mono text-xs tracking-[0.05em] text-white/55">Dubai response*</span>
      </div>
    </div>
  </div>
</section>

<div class="bg-orange px-5 py-3 text-center font-mono text-[13px] tracking-[0.03em] text-white">
  🌍 EXPORT CUSTOMERS WELCOME — we also supply and install UPS &amp; battery systems for projects across the UAE and MENA region.
  <a href="#contact" class="text-white underline">Talk to us about your country →</a>
</div>
