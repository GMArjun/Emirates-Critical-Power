---
import { site } from '../data/site';
---

<section class="hero" id="top">
  <div class="hero-grid"></div>
  <div class="hero-inner">
    <div class="eyebrow" style="justify-content:center;">UPS Installation Dubai — Critical Power Engineering, UAE-Wide</div>
    <h1>UAE's Trusted <span class="hl">UPS Installation</span> &amp; Critical Power Specialists</h1>
    <p class="hero-sub">SUPPLY · INSTALLATION · COMMISSIONING · AMC · BATTERY REPLACEMENT · 24/7 EMERGENCY SUPPORT</p>
    <div class="hero-cta">
      <a href="#contact" class="btn btn-orange btn-lg">Get Free Quote</a>
      <a href={site.whatsapp} class="btn btn-white btn-lg">WhatsApp Now</a>
    </div>

    <div class="waveform-wrap">
      <span class="wf-label left">Mains failure</span>
      <span class="wf-label right">Zero downtime</span>
      <svg viewBox="0 0 900 150" preserveAspectRatio="none" aria-hidden="true">
        <path class="wf-line" d="M0,75 C20,20 40,130 60,75 C80,20 100,130 120,75 C140,20 160,130 180,75 C200,20 220,130 240,75 C260,20 280,130 300,75 C320,45 340,75 360,75 C420,75 460,75 900,75"></path>
        <path class="wf-flat" d="M360,75 L900,75" stroke-dasharray="4 4">
          <animate attributeName="stroke-dashoffset" from="200" to="0" dur="2.4s" repeatCount="indefinite"></animate>
        </path>
        <circle cx="360" cy="75" r="5" fill="#FF6B00"></circle>
      </svg>
    </div>

    <div class="stat-row">
      <div class="stat"><b>1–600</b><span>kVA range</span></div>
      <div class="stat"><b>24/7</b><span>emergency support</span></div>
      <div class="stat"><b>15+</b><span>UPS brands serviced</span></div>
      <div class="stat"><b>&lt;60min</b><span>Dubai response*</span></div>
    </div>
  </div>
</section>

<div style="background:var(--orange);color:var(--white);text-align:center;padding:12px 20px;font-family:'IBM Plex Mono',monospace;font-size:13px;letter-spacing:0.03em;">
  🌍 EXPORT CUSTOMERS WELCOME — we also supply and install UPS &amp; battery systems for projects outside the UAE. <a href="#contact" style="color:var(--white);text-decoration:underline;">Talk to us about your country →</a>
</div>
