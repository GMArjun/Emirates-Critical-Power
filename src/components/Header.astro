---
import { site } from '../data/site';

const btn =
  'inline-flex items-center justify-center gap-2 rounded-md px-[22px] py-[11px] text-sm font-semibold whitespace-nowrap transition-all duration-200';
const btnOrange = `${btn} bg-orange text-white shadow-(--shadow-orange) hover:bg-orange-hover hover:-translate-y-px hover:shadow-(--shadow-orange-lg)`;
const btnOutline = `${btn} border-[1.5px] border-navy bg-transparent text-navy hover:bg-navy hover:text-white px-4 py-2.5`;
---

<header class="sticky top-0 z-100 border-b border-line bg-white/92 backdrop-blur-[10px]">
  <nav class="mx-auto flex max-w-[1200px] items-center justify-between px-6 py-4">
    <a href="/" class="flex items-center gap-2.5 font-display text-lg font-bold text-navy">
      <img
        class="h-11 w-11 shrink-0 rounded-md object-contain"
        src="/logo.png"
        alt={`${site.name} logo`}
        width="44"
        height="44"
      />
      {site.shortName}
    </a>
    <div class="hidden gap-7 text-sm font-medium md:flex">
      <a href="/services" class="py-1 text-navy hover:text-orange">Services</a>
      <a href="/about" class="py-1 text-navy hover:text-orange">About</a>
      <a href="/#industries" class="py-1 text-navy hover:text-orange">Industries</a>
      <a href="/#faq" class="py-1 text-navy hover:text-orange">FAQ</a>
      <a href="/#contact" class="py-1 text-navy hover:text-orange">Contact</a>
    </div>
    <div class="hidden items-center gap-3 sm:flex">
      <a href={`tel:${site.phone}`} class={btnOutline}>Call Now</a>
      <a href={site.whatsapp} class={btnOrange}>WhatsApp</a>
    </div>
    <button class="bg-transparent text-2xl text-navy md:hidden" aria-label="Menu" type="button">☰</button>
  </nav>
</header>
