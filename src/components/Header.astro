---
import { site } from '../data/site';
---

<header>
  <nav>
    <a href="#top" class="logo">
      <img class="logo-mark" src="/logo.png" alt={`${site.name} logo`} width="44" height="44" style="border-radius:6px;" />
      {site.shortName}
    </a>
    <div class="nav-links">
      <a href="#services">Services</a>
      <a href="#battery">Batteries</a>
      <a href="#industries">Industries</a>
      <a href="#brands">Brands</a>
      <a href="#faq">FAQ</a>
      <a href="#contact">Contact</a>
    </div>
    <div class="nav-cta">
      <a href={`tel:${site.phone}`} class="btn btn-outline" style="padding:10px 16px;">Call Now</a>
      <a href={site.whatsapp} class="btn btn-orange">WhatsApp</a>
    </div>
    <button class="menu-toggle" aria-label="Menu" type="button">☰</button>
  </nav>
</header>
