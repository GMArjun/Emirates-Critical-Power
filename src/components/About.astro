---
const capabilities = [
  'UPS Supply & Installation',
  'UPS Testing & Commissioning',
  'Preventive & Corrective Maintenance',
  'UPS Health Check',
  'Battery Replacement & Installation',
  'Battery Monitoring System (BMS)',
  'Emergency Breakdown Support',
  'Annual Maintenance Contracts',
  'Load Bank Testing',
  'UPS Relocation & Retrofit',
  'Power Quality Analysis',
  'UPS Rental Support',
];

const industries = [
  'Data Centers',
  'Hospitals',
  'Banks',
  'Airports',
  'Telecom',
  'Oil & Gas',
  'Government',
];
---

<section id="about">
  <div class="wrap about-grid">
    <div>
      <div class="eyebrow">About the company</div>
      <h2>Independent UPS engineering, built for critical facilities</h2>
      <p style="color:var(--steel);margin-top:14px;font-size:15.5px;">
        Emirates Critical Power LLC is a UAE-based engineering company specializing in complete UPS and battery solutions — from single-phase office UPS to modular, N+1 systems protecting data centers. We supply, install, commission and maintain UPS across the Emirates, and we service multiple brands rather than pushing a single manufacturer's agenda. For export customers, we also arrange supply and on-site installation of UPS and battery systems outside the UAE — get in touch with your project location and load requirements.
      </p>
      <ul class="about-list">
        {capabilities.map((item) => <li>{item}</li>)}
      </ul>
      <div class="about-industries">
        {industries.map((item) => <span class="chip">{item}</span>)}
      </div>
    </div>
    <div class="about-panel">
      <h3>Why facilities choose an independent UPS partner</h3>
      <div class="mono-line"><span>Brand lock-in</span><b>None</b></div>
      <div class="mono-line"><span>Response time (Dubai)</span><b>&lt; 60 min</b></div>
      <div class="mono-line"><span>Engineers</span><b>Certified</b></div>
      <div class="mono-line"><span>Coverage</span><b>UAE-wide</b></div>
      <div class="mono-line"><span>Batteries supplied</span><b>Genuine only</b></div>
      <div class="mono-line" style="border-bottom:none;"><span>Support</span><b>24 / 7</b></div>
    </div>
  </div>
</section>
