---
const services = [
  {
    num: '01',
    title: 'UPS Supply',
    desc: 'Online double-conversion UPS, 1 kVA to 600 kVA, single & three phase.',
    items: ['Modular UPS (N+1)', 'Industrial & data center UPS', 'Parallel redundant systems'],
  },
  {
    num: '02',
    title: 'UPS Installation Dubai',
    desc: 'Full UPS installation support in Dubai and across the UAE — end-to-end, to commissioning standard.',
    items: [
      'Cable termination & power distribution',
      'UPS installation & setup, all capacities',
      'Startup, commissioning & testing',
      'Full installation documentation',
    ],
  },
  {
    num: '03',
    title: 'UPS Maintenance',
    desc: 'Preventive and corrective care that keeps uptime intact.',
    items: ['Preventive & corrective maintenance', 'UPS health check', 'Emergency repair, 24/7'],
  },
  {
    num: '04',
    title: 'Battery Replacement',
    desc: 'VRLA, lithium-ion and NiCd battery banks, sized and installed.',
    items: ['Battery bank installation', 'Capacity testing', 'Responsible disposal'],
  },
  {
    num: '05',
    title: 'Battery Monitoring',
    desc: 'Real-time visibility into the health of every cell.',
    items: ['Voltage & temperature monitoring', 'Predictive maintenance alerts', 'Remote BMS dashboards'],
  },
  {
    num: '06',
    title: 'UPS Commissioning',
    desc: 'Factory and site acceptance testing before go-live.',
    items: ['FAT & SAT', 'Load bank testing', 'Customer training'],
  },
];
---

<section class="bg-grey py-[88px]" id="services">
  <div class="mx-auto max-w-[1200px] px-6">
    <div class="mx-auto mb-12 max-w-[640px] text-center">
      <div class="mb-3.5 flex items-center justify-center gap-2.5 font-mono text-xs tracking-[0.14em] text-orange uppercase before:inline-block before:h-0.5 before:w-[22px] before:bg-orange">
        What we do
      </div>
      <h2 class="text-[clamp(26px,3.4vw,40px)] text-navy">Full lifecycle UPS &amp; battery services</h2>
      <p class="mt-3 text-base text-steel">
        From site survey to decommissioning — one engineering partner across the entire lifecycle of your critical power system.
      </p>
    </div>
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        services.map((service) => (
          <div class="relative rounded-xl border border-line bg-white px-[26px] py-[30px] shadow-[0_2px_10px_rgba(0,51,102,0.05)] transition-all duration-200 hover:-translate-y-1 hover:border-transparent hover:shadow-[0_20px_36px_rgba(0,51,102,0.14)]">
            <span class="mb-3.5 block font-mono text-xs text-orange">{service.num}</span>
            <h3 class="mb-2.5 text-[19px] text-navy">{service.title}</h3>
            <p class="mb-4 text-sm text-steel">{service.desc}</p>
            <ul class="list-none text-[13.5px] text-navy-deep">
              {service.items.map((item, i) => (
                <li class={`py-[5px] ${i === 0 ? '' : 'border-t border-dashed border-line'}`}>{item}</li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</section>
