---
import { services } from '../data/services';
---

<section class="bg-grey py-[88px]" id="services">
  <div class="mx-auto max-w-[1200px] px-6">
    <div class="mx-auto mb-12 max-w-[640px] text-center">
      <div class="mb-3.5 flex items-center justify-center gap-2.5 font-mono text-xs tracking-[0.14em] text-orange uppercase before:inline-block before:h-0.5 before:w-[22px] before:bg-orange">
        What we do
      </div>
      <h2 class="text-[clamp(26px,3.4vw,40px)] text-navy">Full lifecycle UPS &amp; battery services</h2>
      <p class="mt-3 text-base text-steel">
        From site survey to decommissioning — one engineering partner across the entire lifecycle of your critical power system.
      </p>
    </div>
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        services.map((service) => (
          <div class="relative rounded-xl border border-line bg-white px-[26px] py-[30px] shadow-[0_2px_10px_rgba(0,51,102,0.05)] transition-all duration-200 hover:-translate-y-1 hover:border-transparent hover:shadow-[0_20px_36px_rgba(0,51,102,0.14)]">
            <span class="mb-3.5 block font-mono text-xs text-orange">{service.num}</span>
            <h3 class="mb-2.5 text-[19px] text-navy">{service.title}</h3>
            <p class="mb-4 text-sm text-steel">{service.desc}</p>
            <ul class="list-none text-[13.5px] text-navy-deep">
              {service.items.map((item, i) => (
                <li class={`py-[5px] ${i === 0 ? '' : 'border-t border-dashed border-line'}`}>{item}</li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</section>
