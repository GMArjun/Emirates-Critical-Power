---
const industries = [
  { name: 'Data Centers', svg: '<rect x="3" y="4" width="18" height="16" rx="1"/><path d="M7 8h2M7 12h2M7 16h2"/>' },
  { name: 'Banks', svg: '<path d="M3 21h18M5 21V9l7-5 7 5v12"/><path d="M9 21v-6h6v6"/>' },
  { name: 'Hospitals', svg: '<path d="M12 2v20M4 8l8-6 8 6M4 8v13M20 8v13"/>' },
  { name: 'Airports', svg: '<path d="M2 22h20M6 22V10l6-6 6 6v12"/>' },
  { name: 'Oil & Gas', svg: '<circle cx="12" cy="12" r="9"/><path d="M12 3v18M3 12h18"/>' },
  { name: 'Telecom', svg: '<path d="M4 4l7 7-7 7M13 4l7 7-7 7"/>' },
  { name: 'Factories', svg: '<path d="M3 21h18M5 21V7l4-3 4 3v14M13 21V11l6 3v7"/>' },
  { name: 'Commercial', svg: '<rect x="4" y="3" width="16" height="18" rx="1"/><path d="M9 21v-4h6v4"/>' },
  { name: 'Government', svg: '<path d="M12 2l9 4-9 4-9-4z"/><path d="M3 10l9 4 9-4M3 14l9 4 9-4"/>' },
  { name: 'Education', svg: '<path d="M12 3l9 5v3H3V8z"/><path d="M5 11v9M19 11v9M9 11v9M15 11v9"/>' },
  { name: 'Hotels', svg: '<rect x="4" y="2" width="16" height="20" rx="1"/><path d="M8 7h1M15 7h1M8 11h1M15 11h1"/>' },
  { name: 'Retail', svg: '<path d="M3 9l1-5h16l1 5M4 9v11h16V9M4 9h16"/>' },
];
---

<section class="bg-grey py-[88px]" id="industries">
  <div class="mx-auto max-w-[1200px] px-6">
    <div class="mx-auto mb-12 max-w-[640px] text-center" data-reveal>
      <div class="mb-3.5 flex items-center justify-center gap-2.5 font-mono text-xs tracking-[0.14em] text-orange uppercase before:inline-block before:h-0.5 before:w-[22px] before:bg-orange">
        Who we serve
      </div>
      <h2 class="text-[clamp(26px,3.4vw,40px)] text-navy">Industries running on continuous power</h2>
    </div>
    <div class="grid grid-cols-2 overflow-hidden rounded-xl border border-line bg-line gap-px sm:grid-cols-2 lg:grid-cols-4">
      {
        industries.map((item, i) => (
          <div
            class="group bg-white px-[18px] py-[26px] text-center transition-colors hover:bg-navy hover:text-white"
            data-reveal
            style={`--i: ${i}`}
          >
            <svg
              class="mx-auto mb-2.5 h-[26px] w-[26px] stroke-navy transition-colors group-hover:stroke-orange"
              viewBox="0 0 24 24"
              fill="none"
              stroke-width="1.8"
              set:html={item.svg}
            />
            <span class="text-[13px] font-medium">{item.name}</span>
          </div>
        ))
      }
    </div>
  </div>
</section>
