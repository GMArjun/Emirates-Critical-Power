---
import { Image } from 'astro:assets';

const images = [
  {
    src: 'https://images.unsplash.com/photo-1742491387035-f658e8a2b7f4?fm=jpg&q=80&w=900&auto=format&fit=crop',
    alt: 'Burj Khalifa and Dubai skyline at night',
    cap: 'Dubai, UAE',
  },
  {
    src: 'https://images.unsplash.com/photo-1682878355106-0c076b17f56d?fm=jpg&q=80&w=900&auto=format&fit=crop',
    alt: 'Dubai Metro train against the city skyline',
    cap: 'Dubai Metro corridor',
  },
  {
    src: 'https://images.unsplash.com/photo-1695668548342-c0c1ad479aee?fm=jpg&q=80&w=900&auto=format&fit=crop',
    alt: 'UPS and server racks in a data center',
    cap: 'UPS & data center racks',
  },
  {
    src: 'https://images.unsplash.com/photo-1742899273038-67ff67477663?fm=jpg&q=80&w=900&auto=format&fit=crop',
    alt: 'Rows of a VRLA battery bank',
    cap: 'VRLA battery bank',
  },
  {
    src: 'https://images.unsplash.com/photo-1716062890647-60feae0609d0?fm=jpg&q=80&w=900&auto=format&fit=crop',
    alt: 'A UPS uninterruptible power supply unit',
    cap: 'UPS unit',
  },
];
---

<section class="bg-white py-[88px]">
  <div class="mx-auto max-w-[1200px] px-6">
    <div class="mx-auto mb-12 max-w-[640px] text-center" data-reveal>
      <div class="mb-3.5 flex items-center justify-center gap-2.5 font-mono text-xs tracking-[0.14em] text-orange-ink uppercase before:inline-block before:h-0.5 before:w-[22px] before:bg-orange">
        Representative imagery
      </div>
      <h2 class="text-[clamp(26px,3.4vw,40px)] text-navy">UPS rooms, battery banks &amp; commissioning</h2>
      <p class="mt-3 text-base text-steel">
        The kind of environments UPS and battery systems operate in, from Dubai's skyline to the battery room floor — real project photos coming soon.
      </p>
    </div>
    <div class="grid grid-cols-2 gap-4 lg:grid-cols-5">
      {
        images.map((img, i) => (
          <div class="group relative aspect-4/5 overflow-hidden rounded-[10px] bg-navy-deep" data-reveal style={`--i: ${i}`}>
            <Image
              class="img-fade h-full w-full object-cover transition-transform duration-[350ms] group-hover:scale-105"
              src={img.src}
              alt={img.alt}
              width={640}
              height={800}
              loading="lazy"
              onload="this.classList.add('is-loaded')"
            />
            <div class="absolute inset-x-0 bottom-0 bg-linear-to-t from-navy-deep/92 to-transparent px-3.5 pt-3.5 pb-3 font-mono text-[12.5px] tracking-[0.02em] text-white">
              {img.cap}
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
